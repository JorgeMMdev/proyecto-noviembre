{# Cabecera + navegación. Usa las variables globales "usuario" (null si no hay sesión) y "ruta" (URL actual). #}
{% set u = usuario|default(null) %}
{% set rutaActual = ruta|default('/') %}

{% set enlaces = [
    {url: '/', texto: 'Inicio'},
    {url: '/servicios', texto: 'Buscar servicios'}
] %}

{% if u and u.rol == 'ADMIN' %}
    {% set enlaces = enlaces|merge([
        {url: '/admin', texto: 'Panel admin'}
    ]) %}
{% elseif u %}
    {% set enlaces = enlaces|merge([
        {url: '/perfil', texto: 'Mi perfil'},
        {url: '/solicitudes', texto: 'Mis solicitudes'}
    ]) %}
{% endif %}

<header class="cabecera">
    <div class="contenedor cabecera-dentro">
        <a class="marca" href="/">Banco de Horas</a>

        <button class="boton-menu" type="button"
                aria-expanded="false" aria-controls="menu-principal"
                aria-label="Abrir menú">
            <span aria-hidden="true">☰</span>
        </button>

        <nav id="menu-principal" class="menu" aria-label="Principal">
            <ul class="menu-enlaces">
                {% for enlace in enlaces %}
                    {% set activo = enlace.url == '/' ? rutaActual == '/' : rutaActual starts with enlace.url %}
                    <li>
                        <a href="{{ enlace.url }}"{% if activo %} class="activo" aria-current="page"{% endif %}>
                            {{ enlace.texto }}
                        </a>
                    </li>
                {% endfor %}
            </ul>

            <div class="menu-cuenta">
                {% if u %}
                    <span>{{ u.nombre }}</span>
                    <form method="post" action="/auth/logout">
                        <button type="submit" class="boton-borde">Salir</button>
                    </form>
                {% else %}
                    <a class="boton-borde" href="/auth/login" id="btnIniciarSesion">Iniciar sesión</a>
                    <a class="boton" href="/auth/registro" id="btnRegistrarse">Registrarse</a>
                {% endif %}
            </div>
        </nav>
    </div>
</header>