{# Tarjeta de una solicitud. Recibe "s" (la fila) y "rol" ('profesional' o 'cliente') #}
{% set nombresEstado = {
    'SOLICITADO': 'Solicitado',
    'ACEPTADO': 'Aceptado',
    'RECHAZADO': 'Rechazado',
    'EN_EJECUCION': 'En ejecución',
    'COMPLETADO': 'Completado',
    'CANCELADO': 'Cancelado'
} %}
{% set horas = s.tiempo_final|number_format(1, ',', '.')|replace({',0': ''}) %}

{# "yo" y "el otro" cambian según desde qué lado se mira #}
{% set yoConfirme = rol == 'profesional' ? s.confirmado_prestador : s.confirmado_cliente %}
{% set otroConfirmo = rol == 'profesional' ? s.confirmado_cliente : s.confirmado_prestador %}

{# Qué botones salen, según el estado y desde qué lado se mira #}
{% set enCurso = s.estado in ['ACEPTADO', 'EN_EJECUCION'] %}
{% set sinConfirmar = not s.confirmado_cliente and not s.confirmado_prestador %}
{% set puedeResponder = rol == 'profesional' and s.estado == 'SOLICITADO' %}
{% set puedeCancelar = rol == 'cliente'
    and (s.estado == 'SOLICITADO' or (s.estado == 'ACEPTADO' and sinConfirmar)) %}
{% set puedeConfirmar = enCurso and not yoConfirme %}

<li class="caja solicitud">
    <h2>{{ s.nombre_servicio }}</h2>
    <p class="suave">
        {{ rol == 'profesional' ? 'Cliente' : 'Profesional' }}:
        <strong>{{ s.otro_nombre }} {{ s.otro_apellidos }}</strong>
    </p>

    <dl class="datos">
        <div><dt>Estado</dt><dd>{{ nombresEstado[s.estado] }}</dd></div>
        <div><dt>Fecha</dt><dd>{{ s.fecha_propuesta|date('d/m/Y · H:i') }}</dd></div>
        <div><dt>Duración</dt><dd>{{ horas }} h</dd></div>
        <div><dt>Puntos</dt><dd>{{ s.precio_final }} pts</dd></div>
    </dl>

    {% if enCurso %}
        <ul class="confirmaciones">
            <li class="{{ yoConfirme ? 'verde' : 'suave' }}">
                {{ yoConfirme ? '✓ Has confirmado que está hecho' : '● Falta tu confirmación' }}
            </li>
            <li class="{{ otroConfirmo ? 'verde' : 'suave' }}">
                {{ otroConfirmo ? '✓' : '●' }} {{ s.otro_nombre }} {{ otroConfirmo ? 'ha confirmado' : 'aún no ha confirmado' }}
            </li>
        </ul>
    {% endif %}

    {% if s.estado == 'COMPLETADO' %}
        {% if s.puntuacion is not null %}
            <div class="valoracion">
                <span class="estrellas" aria-label="{{ s.puntuacion }} de 5 estrellas">
                    {% for i in 1..5 %}<span class="{{ i <= s.puntuacion ? 'llena' : '' }}">★</span>{% endfor %}
                </span>
                {% if s.comentario %}<p class="suave">«{{ s.comentario }}»</p>{% endif %}
            </div>
        {% elseif rol == 'cliente' %}
            <div class="botones">
                <button
                    type="button"
                    class="boton boton-valorar"
                    data-id="{{ s.id_solicitud }}"
                    data-servicio="{{ s.nombre_servicio }}"
                >Valorar servicio</button>
            </div>
        {% else %}
            <p class="suave">{{ s.otro_nombre }} aún no ha valorado el servicio.</p>
        {% endif %}
    {% endif %}

    {% if puedeResponder or puedeCancelar or puedeConfirmar %}
        <p class="aviso aviso-error" role="alert" hidden></p>
        <div class="botones">
            {% if puedeResponder %}
                <button type="button" class="boton" data-id="{{ s.id_solicitud }}" data-accion="aceptar">Aceptar</button>
                <button type="button" class="boton-borde" data-id="{{ s.id_solicitud }}" data-accion="rechazar">Rechazar</button>
            {% endif %}
            {% if puedeConfirmar %}
                <button type="button" class="boton" data-id="{{ s.id_solicitud }}" data-accion="confirmar">Confirmar finalizado</button>
            {% endif %}
            {% if puedeCancelar %}
                <button type="button" class="boton-borde" data-id="{{ s.id_solicitud }}" data-accion="cancelar">Cancelar solicitud</button>
            {% endif %}
        </div>
    {% endif %}
</li>
