{% extends 'layout.html.twig' %}

{% block title %}Servicios{% endblock %}

{% block content %}
    <h1>Servicios</h1>

    <form method="get" action="/servicios">
        <input type="search" name="q" value="{{ texto }}" placeholder="Buscar servicio...">

        <select name="categoria">
            <option value="">Todas las categorías</option>
            {% for c in categorias %}
                <option value="{{ c.idCategoria }}" {{ c.idCategoria == categoriaId ? 'selected' }}>
                    {{ c.nombreCategoria }}
                </option>
            {% endfor %}
        </select>

        <button type="submit">Buscar</button>
    </form>

    {% if servicios is empty %}
        <p>No hay servicios que coincidan con tu búsqueda.</p>
    {% else %}
        <ul>
            {% for s in servicios %}
                <li>
                    <a href="/servicios/{{ s.idServicio }}">{{ s.nombreServicio }}</a>
                    · {{ s.precioMedioEstimado }} pts/h
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}