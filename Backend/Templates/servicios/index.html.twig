{% extends 'layout.html.twig' %}

{% block title %}Servicios{% endblock %}

{% block content %}
{# Nombre de cada categoría por su id, para ponerlo en las tarjetas.
   La clave lleva una "c" delante porque merge renumeraría las claves numéricas #}
{% set nombresCategoria = {} %}
{% for c in categorias %}
    {% set nombresCategoria = nombresCategoria|merge({('c' ~ c.idCategoria): c.nombreCategoria}) %}
{% endfor %}

<section class="buscador" aria-labelledby="bus-titulo">
    <h1 id="bus-titulo">Encuentra un servicio</h1>
    <p class="suave">Busca lo que necesitas y elige al profesional que mejor te encaje.</p>

    <form class="buscador-form" method="get" action="/servicios" role="search">
        <label class="oculto" for="bus-texto">Buscar servicio</label>
        <input id="bus-texto" type="search" name="q" value="{{ texto }}"
               placeholder="Ej.: clases de inglés, fontanería…">

        <label class="oculto" for="bus-categoria">Categoría</label>
        <select id="bus-categoria" name="categoria" onchange="this.form.submit()">
            <option value="">Todas las categorías</option>
            {% for c in categorias %}
                <option value="{{ c.idCategoria }}" {{ c.idCategoria == categoriaId ? 'selected' }}>
                    {{ c.nombreCategoria }}
                </option>
            {% endfor %}
        </select>

        <button class="boton" type="submit">Buscar</button>
    </form>
</section>

<p class="suave" aria-live="polite">
    {{ servicios|length }} {{ servicios|length == 1 ? 'servicio' : 'servicios' }}
    {% if texto %}para «{{ texto }}»{% endif %}
</p>

{% if servicios is empty %}
    <div class="vacio">
        <p>No hay servicios que coincidan con tu búsqueda.</p>
        <a href="/servicios">Ver todos los servicios</a>
    </div>
{% else %}
    <ul class="rejilla">
        {% for s in servicios %}
            <li>
                <a class="caja tarjeta" href="/servicios/{{ s.idServicio }}">
                    <span class="categoria">{{ nombresCategoria['c' ~ s.idCategoria] ?? '' }}</span>
                    <h2>{{ s.nombreServicio }}</h2>
                    <p class="suave">{{ s.descripcion }}</p>
                    <div class="barra">
                        <span class="puntos">{{ s.precioMedioEstimado }} pts/h</span>
                        <span class="suave">≈ {{ s.tiempoMedioEstimado|number_format(1, ',', '.')|replace({',0': ''}) }} h</span>
                    </div>
                    <span class="ver-mas">Ver profesionales →</span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
{% endblock %}