{% extends 'layout.html.twig' %}

{% block title %}{{ servicio.nombreServicio }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/servicio.css">
{% endblock %}

{% block content %}
    <section class="ficha-cabecera" aria-labelledby="ficha-titulo">
        <a class="ficha-volver" href="/servicios">← Volver a servicios</a>
        <h1 id="ficha-titulo" class="ficha-titulo">{{ servicio.nombreServicio }}</h1>
        <p class="ficha-descripcion">{{ servicio.descripcion }}</p>
        <div class="ficha-datos">
            <span class="ficha-chip">Referencia: {{ servicio.precioMedioEstimado }} pts/h</span>
            <span class="ficha-chip ficha-chip--claro">Tiempo estimado: {{ servicio.tiempoMedioEstimado }} h</span>
        </div>
    </section>

    <section class="ficha-seccion" aria-labelledby="ficha-profesionales">
        <h2 id="ficha-profesionales" class="ficha-seccion__titulo">Profesionales que lo ofrecen</h2>

        {% if ofertas is empty %}
            <p class="ficha-vacio">Nadie ofrece este servicio todavía.</p>
        {% else %}
            <ul class="ficha-ofertas">
                {% for oferta in ofertas %}
                    <li class="ficha-oferta">
                        <div class="ficha-oferta__autor">
                            <span class="ficha-avatar" aria-hidden="true">
                                {{ (oferta.nombre|first ~ oferta.apellidos|first)|upper }}
                            </span>
                            <div>
                                <h3 class="ficha-oferta__nombre">{{ oferta.nombre }} {{ oferta.apellidos }}</h3>
                                <span class="ficha-oferta__valoracion">
                                    {% if oferta.valoracion_media is null %}
                                        Sin valoraciones
                                    {% else %}
                                        ★ {{ oferta.valoracion_media|number_format(1, ',', '.') }}
                                    {% endif %}
                                </span>
                            </div>
                        </div>

                        <p class="ficha-oferta__texto">
                            {{ oferta.descripcion_personal ?: 'Este profesional aún no ha escrito una descripción.' }}
                        </p>

                        <div class="ficha-oferta__pie">
                            <span class="ficha-oferta__puntos">{{ oferta.puntos_hora }} pts/h</span>
                            {% if usuario %}
                                <button
                                    type="button"
                                    class="ficha-boton ficha-solicitar"
                                    data-id="{{ oferta.id_oferta }}"
                                    data-puntos="{{ oferta.puntos_hora }}"
                                    data-profesional="{{ oferta.nombre }} {{ oferta.apellidos }}"
                                >Solicitar</button>
                            {% else %}
                                <a class="ficha-boton" href="/auth/login">Inicia sesión para solicitar</a>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% endblock %}

{% block scripts %}
    <script src="/js/servicio.js"></script>
{% endblock %}
