{% extends 'layout.html.twig' %}

{% block title %}{{ servicio.nombreServicio }}{% endblock %}

{% block content %}
    <section aria-labelledby="ficha-titulo">
        <a class="volver" href="/servicios">← Volver a servicios</a>
        <h1 id="ficha-titulo">{{ servicio.nombreServicio }}</h1>
        <p class="suave">{{ servicio.descripcion }}</p>
        <div class="chips">
            <span class="puntos">Referencia: {{ servicio.precioMedioEstimado }} pts/h</span>
            <span class="puntos etiqueta">Tiempo estimado: {{ servicio.tiempoMedioEstimado }} h</span>
        </div>
    </section>

    <section class="seccion" aria-labelledby="ficha-profesionales">
        <h2 id="ficha-profesionales">Profesionales que lo ofrecen</h2>

        {% if ofertas is empty %}
            <p class="vacio">Nadie ofrece este servicio todavía.</p>
        {% else %}
            <ul class="lista">
                {% for oferta in ofertas %}
                    <li class="caja">
                        <div class="autor">
                            <span class="avatar" aria-hidden="true">
                                {{ (oferta.nombre|first ~ oferta.apellidos|first)|upper }}
                            </span>
                            <div>
                                <h3>{{ oferta.nombre }} {{ oferta.apellidos }}</h3>
                                <span class="suave">
                                    {% if oferta.valoracion_media is null %}
                                        Sin valoraciones
                                    {% else %}
                                        ★ {{ oferta.valoracion_media|number_format(1, ',', '.') }}
                                    {% endif %}
                                </span>
                            </div>
                        </div>

                        <p>
                            {{ oferta.descripcion_personal ?: 'Este profesional aún no ha escrito una descripción.' }}
                        </p>

                        <div class="barra">
                            <span class="puntos">{{ oferta.puntos_hora }} pts/h</span>
                            {% if usuario %}
                                <button
                                    type="button"
                                    class="boton boton-solicitar"
                                    data-id="{{ oferta.id_oferta }}"
                                    data-puntos="{{ oferta.puntos_hora }}"
                                    data-profesional="{{ oferta.nombre }} {{ oferta.apellidos }}"
                                >Solicitar</button>
                            {% else %}
                                <a class="boton" href="/auth/login">Inicia sesión para solicitar</a>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% endblock %}

{% block scripts %}
    <script src="/js/servicio.js"></script>
{% endblock %}
