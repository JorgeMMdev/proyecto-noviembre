{% extends 'layout.html.twig' %}

{% block title %}Código de verificación{% endblock %}

{% block content %}
    <section class="caja caja-estrecha">
        <h1>Revisa tu correo</h1>

        <p class="suave">
            Hemos enviado un código de 6 cifras a <strong>{{ correoDestino }}</strong>.
            Escríbelo para terminar de iniciar sesión. Caduca en 5 minutos.
        </p>

        {% if error %}
            <p class="aviso aviso-error" role="alert">{{ error }}</p>
        {% endif %}

        <form method="post" action="/auth/codigo" class="form">
            <div class="campo">
                <label for="codigo">Código de verificación</label>
                <input type="text" id="codigo" name="codigo" inputmode="numeric"
                       autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}"
                       required autofocus>
            </div>

            <button type="submit" class="boton boton-ancho">Verificar</button>
        </form>

        <p class="suave centrado"><a href="/auth/login">¿No te ha llegado? Vuelve a iniciar sesión</a></p>
    </section>
{% endblock %}