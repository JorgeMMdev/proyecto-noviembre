{% extends 'layout.html.twig' %}

{% block title %}Iniciar sesión{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/formularios.css">
{% endblock %}

{% block content %}
    <section class="tarjeta-formulario">
        <h1>Iniciar sesión</h1>

        <p class="alerta alerta--error" id="loginError" role="alert" hidden></p>

        <form method="post" action="/auth/login" class="formulario" id="formLogin">
            <div class="campo">
                <label for="correo">Correo electrónico</label>
                <input type="email" id="correo" name="correo"
                       autocomplete="email" required autofocus>
            </div>

            <div class="campo">
                <label for="contrasena">Contraseña</label>
                <input type="password" id="contrasena" name="contrasena"
                       autocomplete="current-password" required>
            </div>

            <button type="submit" class="boton boton--ancho">Entrar</button>
        </form>

        <p class="formulario__pie">¿No tienes cuenta? <a href="/auth/registro">Regístrate</a></p>
    </section>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script src="/js/login.js"></script>
{% endblock %}