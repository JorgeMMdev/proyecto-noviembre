{% extends 'layout.html.twig' %}

{% block title %}Iniciar sesión{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/formularios.css">
{% endblock %}

{% block content %}
    <section class="tarjeta-formulario">
        <h1>Iniciar sesión</h1>

        {% if error %}
            <p class="alerta alerta--error" role="alert">{{ error }}</p>
        {% endif %}

        <form method="post" action="/auth/login" class="formulario">
            <div class="campo">
                <label for="correo">Correo electrónico</label>
                <input type="email" id="correo" name="correo" value="{{ correo }}"
                       autocomplete="email" required autofocus>
            </div>

            <div class="campo">
                <label for="contrasena">Contraseña</label>
                <input type="password" id="contrasena" name="contrasena"
                       autocomplete="current-password" required>
            </div>

            <button type="submit" class="boton boton--ancho">Entrar</button>
        </form>

        <p class="formulario__pie">Te enviaremos un código a tu correo para confirmar que eres tú.</p>
    </section>
{% endblock %}