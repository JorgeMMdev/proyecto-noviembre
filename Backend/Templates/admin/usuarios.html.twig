{% extends 'layout.html.twig' %}

{% block title %}Usuarios · Panel de administración{% endblock %}

{% block content %}
<h1>Panel de administración</h1>
{% include 'admin/_secciones.html.twig' with {activa: 'usuarios'} %}
{% include 'admin/_flash.html.twig' %}

<div class="barra">
    <h2>Usuarios ({{ usuarios|length }})</h2>
</div>

<div class="tabla-scroll">
    <table class="tabla">
        <thead>
            <tr>
                <th scope="col">Usuario</th>
                <th scope="col">Rol</th>
                <th scope="col">Saldo</th>
                <th scope="col">Valoración</th>
                <th scope="col">Ofertas</th>
                <th scope="col">Solicitudes abiertas</th>
                <th scope="col">Estado</th>
                <th scope="col"><span class="oculto">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
            {% for u in usuarios %}
                <tr{% if not u.activo %} class="inactivo"{% endif %}>
                    <td>
                        <span class="negrita">{{ u.nombre }} {{ u.apellidos }}</span><br>
                        <span class="suave">{{ u.correo }}</span>
                    </td>
                    <td>{{ u.rol == 'ADMIN' ? 'Admin' : 'Profesional' }}</td>
                    <td>{{ u.saldo }} pts</td>
                    <td>
                        {% if u.valoracion_media is null %}—{% else %}★ {{ u.valoracion_media|number_format(1, ',', '.') }}{% endif %}
                    </td>
                    <td>{{ u.ofertas }}</td>
                    <td>{{ u.abiertas }}</td>
                    <td>
                        <span class="etiqueta {{ u.activo ? 'verde' : 'rojo' }}">
                            {{ u.activo ? 'Activo' : 'De baja' }}
                        </span>
                    </td>
                    <td class="acciones">
                        {% if u.rol == 'ADMIN' %}
                            {# El administrador no se puede dar de baja #}
                        {% elseif u.activo %}
                            <form class="en-linea" method="post" action="/usuarios/{{ u.id_usuario }}/baja"
                                  onsubmit="return confirm('¿Dar de baja a {{ (u.nombre ~ ' ' ~ u.apellidos)|e('js') }}? Se desactivarán sus ofertas y se cancelarán sus {{ u.abiertas }} solicitud(es) abiertas, devolviendo los puntos.')">
                                <button type="submit" class="boton-rojo">Dar de baja</button>
                            </form>
                        {% else %}
                            <form class="en-linea" method="post" action="/usuarios/{{ u.id_usuario }}/reactivar">
                                <button type="submit" class="boton-borde">Reactivar</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="centrado suave">No hay usuarios.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}