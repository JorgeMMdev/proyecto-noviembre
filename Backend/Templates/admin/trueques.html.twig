{% extends 'layout.html.twig' %}

{% block title %}Trueques · Panel de administración{% endblock %}

{% block content %}
{% set nombresEstado = {
    'SOLICITADO': 'Solicitado',
    'ACEPTADO': 'Aceptado',
    'RECHAZADO': 'Rechazado',
    'EN_EJECUCION': 'En ejecución',
    'COMPLETADO': 'Completado',
    'CANCELADO': 'Cancelado'
} %}

<h1>Panel de administración</h1>
{% include 'admin/_secciones.html.twig' with {activa: 'trueques'} %}
{% include 'admin/_flash.html.twig' %}

{# ---------- Cifras generales ---------- #}
<dl class="cifras">
    <div class="cifra"><dt>Trueques</dt><dd>{{ resumen.total }}</dd></div>
    <div class="cifra"><dt>Completados</dt><dd>{{ resumen.completados }}</dd></div>
    <div class="cifra"><dt>Puntos transferidos</dt><dd>{{ resumen.transferidos }} pts</dd></div>
    <div class="cifra"><dt>Puntos en movimiento</dt><dd>{{ resumen.en_movimiento }} pts</dd></div>
</dl>

<div class="barra">
    <h2>Historial ({{ trueques|length }})</h2>

    {# Filtro por estado: un formulario GET normal, la URL queda como /trueques?estado=ACEPTADO #}
    <form class="filtro" method="get" action="/trueques">
        <label for="estado">Estado</label>
        <select id="estado" name="estado" onchange="this.form.submit()">
            <option value="">Todos</option>
            {% for e in estados %}
                <option value="{{ e.value }}" {{ e.value == filtro ? 'selected' }}>{{ nombresEstado[e.value] }}</option>
            {% endfor %}
        </select>
        <noscript><button type="submit" class="boton-borde">Filtrar</button></noscript>
    </form>
</div>

<div class="tabla-scroll">
    <table class="tabla">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Servicio</th>
                <th scope="col">Cliente → Profesional</th>
                <th scope="col">Fecha</th>
                <th scope="col">Puntos</th>
                <th scope="col">Estado</th>
                <th scope="col">Valoración</th>
                <th scope="col"><span class="oculto">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
            {% for t in trueques %}
                <tr>
                    <td class="suave">{{ t.id_solicitud }}</td>
                    <td class="negrita">{{ t.nombre_servicio }}</td>
                    <td>
                        {{ t.cliente_nombre }} {{ t.cliente_apellidos }}<br>
                        <span class="suave">→ {{ t.profesional_nombre }} {{ t.profesional_apellidos }}</span>
                    </td>
                    <td>{{ t.fecha_propuesta|date('d/m/Y H:i') }}</td>
                    <td>{{ t.precio_final }} pts</td>
                    <td><span class="etiqueta estado-{{ t.estado|lower }}">{{ nombresEstado[t.estado] }}</span></td>
                    <td>
                        {% if t.puntuacion is not null %}
                            <div class="valoracion">
                                <span class="estrellas" aria-label="{{ t.puntuacion }} de 5">{% for i in 1..5 %}{{ i <= t.puntuacion ? '★' : '☆' }}{% endfor %}</span>
                                {% if t.comentario %}<span class="suave">«{{ t.comentario }}»</span>{% endif %}
                                <form method="post" action="/trueques/{{ t.id_solicitud }}/moderar"
                                      onsubmit="return confirm('¿Eliminar esta valoración? Se recalculará la media del profesional.')">
                                    <input type="hidden" name="filtro" value="{{ filtro }}">
                                    <button type="submit" class="enlace-rojo">Eliminar valoración</button>
                                </form>
                            </div>
                        {% else %}
                            <span class="suave">—</span>
                        {% endif %}
                    </td>
                    <td class="acciones">
                        {% if t.estado in ['SOLICITADO', 'ACEPTADO', 'EN_EJECUCION'] %}
                            <form class="en-linea" method="post" action="/trueques/{{ t.id_solicitud }}/cancelar"
                                  onsubmit="return confirm('¿Cancelar la solicitud #{{ t.id_solicitud }}? Se devolverán {{ t.precio_final }} pts al cliente.')">
                                <input type="hidden" name="filtro" value="{{ filtro }}">
                                <button type="submit" class="boton-rojo">Cancelar</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="centrado suave">No hay trueques{{ filtro ? ' con ese estado' }}.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}