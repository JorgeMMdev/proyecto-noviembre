{% extends 'layout.html.twig' %}

{% block title %}Editar servicio · Panel de administración{% endblock %}

{% block content %}
<h1>Panel de administración</h1>
{% include 'admin/_secciones.html.twig' with {activa: 'servicios'} %}

<section class="caja caja-estrecha" aria-labelledby="titulo-editar">
    <a class="volver" href="/catalogo">← Volver al catálogo</a>
    <h2 id="titulo-editar">Editar «{{ servicio.nombreServicio }}»</h2>

    <form class="form" method="post" action="/catalogo/{{ servicio.idServicio }}/editar" novalidate>
        {% include 'admin/_campos_servicio.html.twig' %}

        <div class="botones">
            <a class="boton-borde" href="/catalogo">Cancelar</a>
            <button type="submit" class="boton">Guardar cambios</button>
        </div>
    </form>
</section>
{% endblock %}