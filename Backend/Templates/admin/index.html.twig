{% extends 'layout.html.twig' %}

{% block title %}Panel de administración{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/admin.css">
{% endblock %}

{% block content %}
    <h1 class="adm-titulo">Panel de administración</h1>

    <div class="adm-pestanas" role="tablist" aria-label="Secciones del panel">
        <button type="button" class="adm-pestana" role="tab" id="tab-categorias" aria-controls="panel-categorias" aria-selected="true">Categorías</button>
        <button type="button" class="adm-pestana" role="tab" id="tab-servicios" aria-controls="panel-servicios" aria-selected="false">Servicios</button>
        <button type="button" class="adm-pestana" role="tab" id="tab-usuarios" aria-controls="panel-usuarios" aria-selected="false">Usuarios</button>
        <button type="button" class="adm-pestana" role="tab" id="tab-trueques" aria-controls="panel-trueques" aria-selected="false">Trueques</button>
    </div>

    {# Cada panel empieza vacío: admin.js lo rellena con fetch al abrir la pestaña #}
    <section class="adm-panel" role="tabpanel" id="panel-categorias" aria-labelledby="tab-categorias">
        <div class="adm-barra">
            <h2 class="adm-subtitulo">Categorías</h2>
            <button type="button" class="adm-boton adm-boton--primario" id="nuevaCategoria">+ Nueva categoría</button>
        </div>
        <p class="adm-error" role="alert" hidden></p>
        <div class="adm-tabla-envoltorio">
            <table class="adm-tabla">
                <thead>
                    <tr><th scope="col">Nombre</th><th scope="col">Descripción</th><th scope="col">Servicios</th><th scope="col"><span class="adm-oculto">Acciones</span></th></tr>
                </thead>
                <tbody id="filasCategorias">
                    <tr><td colspan="4" class="adm-cargando">Cargando…</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="adm-panel" role="tabpanel" id="panel-servicios" aria-labelledby="tab-servicios" hidden>
    <div class="adm-barra">
        <h2 class="adm-subtitulo">Catálogo de servicios</h2>
        <button type="button" class="adm-boton adm-boton--primario" id="nuevoServicio">+ Nuevo servicio</button>
    </div>
    <p class="adm-error" role="alert" hidden></p>
    <div class="adm-tabla-envoltorio">
        <table class="adm-tabla">
            <thead>
                <tr>
                    <th scope="col">Servicio</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Referencia</th>
                    <th scope="col">Tiempo</th>
                    <th scope="col">Profesionales</th>
                    <th scope="col"><span class="adm-oculto">Acciones</span></th>
                </tr>
            </thead>
            <tbody id="filasServicios">
                <tr><td colspan="6" class="adm-cargando">Cargando…</td></tr>
            </tbody>
        </table>
    </div>
</section>
    <section class="adm-panel" role="tabpanel" id="panel-usuarios" aria-labelledby="tab-usuarios" hidden>
        <p class="adm-vacio">Próximamente.</p>
    </section>
    <section class="adm-panel" role="tabpanel" id="panel-trueques" aria-labelledby="tab-trueques" hidden>
        <p class="adm-vacio">Próximamente.</p>
    </section>
{% endblock %}

{% block scripts %}
    <script src="/js/admin.js"></script>
{% endblock %}
